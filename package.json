{
  "name": "easylink-ai-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI layer for the EasyLink Solar website and portals: events, generic actions, policy, autonomy, agents and the human inbox.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/http/local.ts",
    "start": "node dist/http/local.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.infra.json",
    "test": "vitest run",
    "cdk": "cdk",
    "synth": "CDK_OUTDIR=cdk.out tsx infra/app.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.700.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-eventbridge": "^3.700.0",
    "@aws-sdk/client-pinpoint-sms-voice-v2": "^3.1153.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-secrets-manager": "^3.1153.0",
    "@aws-sdk/client-sesv2": "^3.1153.0",
    "@aws-sdk/client-verifiedpermissions": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "ulid": "^2.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.146",
    "@types/node": "^22.10.2",
    "aws-cdk-lib": "^2.173.0",
    "constructs": "^10.4.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
