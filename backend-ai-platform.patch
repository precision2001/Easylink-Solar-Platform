@@ -0,0 +1,72 @@
+import { prisma } from '../../config/database.js';
+import { UserRole } from '../../generated/prisma/client.js';
+import { AppError } from '../../middlewares/errorHandler.js';
+
+/**
+ * Who may see a customer's project (everything for or about that customer).
+ *
+ *   ADMIN     — every project.
+ *   INSTALLER — projects where they are the lead's installer now: an open
+ *               InstallerAssignment row, or `Lead.assignedToId` (for leads
+ *               assigned before history was kept). They see the whole project,
+ *               including what earlier installers did.
+ *   CUSTOMER  — their own project only.
+ *
+ * A project is the customer (a CUSTOMER user) and every lead on their designs.
+ */
+export type Viewer = { userId: string; role: string };
+export type ProjectAccess = 'staff' | 'installer' | 'customer';
+
+/** Leads that belong to a customer: leads on designs they own. */
+export async function projectLeadIds(customerId: string): Promise<string[]> {
+  const leads = await prisma.lead.findMany({
+    where: { design: { userId: customerId } },
+    select: { id: true },
+  });
+  return leads.map((l) => l.id);
+}
+
+/** Customers an installer is on now (open assignment or current assignee). */
+export async function installerCustomerIds(installerId: string): Promise<string[]> {
+  const [open, assigned] = await Promise.all([
+    prisma.installerAssignment.findMany({
+      where: { installerId, endedAt: null },
+      select: { leadId: true, customerId: true },
+    }),
+    prisma.lead.findMany({
+      where: { assignedToId: installerId, designId: { not: null } },
+      select: { id: true, design: { select: { userId: true } } },
+    }),
+  ]);
+  // A lead the installer was moved off stays off, even if `assignedToId` lags behind.
+  const closed = new Set(
+    (
+      await prisma.installerAssignment.findMany({
+        where: { installerId, endedAt: { not: null }, leadId: { in: assigned.map((l) => l.id) } },
+        select: { leadId: true },
+      })
+    ).map((a) => a.leadId),
+  );
+  const openLeads = new Set(open.map((a) => a.leadId));
+  const ids = new Set<string>();
+  for (const a of open) if (a.customerId) ids.add(a.customerId);
+  for (const l of assigned) {
+    if (closed.has(l.id) && !openLeads.has(l.id)) continue;
+    if (l.design?.userId) ids.add(l.design.userId);
+  }
+  return [...ids];
+}
+
+export async function resolveProjectAccess(viewer: Viewer, customerId: string): Promise<ProjectAccess> {
+  if (viewer.role === UserRole.ADMIN) return 'staff';
+  if (viewer.role === UserRole.CUSTOMER) {
+    if (viewer.userId === customerId) return 'customer';
+    throw new AppError('You can only see your own project.', 403);
+  }
+  if (viewer.role === UserRole.INSTALLER) {
+    const mine = await installerCustomerIds(viewer.userId);
+    if (mine.includes(customerId)) return 'installer';
+    throw new AppError('This customer is not assigned to you.', 403);
+  }
+  throw new AppError('Insufficient permissions.', 403);
+}
