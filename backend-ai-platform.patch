@@ -0,0 +1,20 @@
+import type { Request, Response } from 'express';
+import { sendResponse } from '../../utils/apiResponse.js';
+import { routeParam } from '../../utils/routeParams.js';
+import { partnerService } from './partner.service.js';
+import type { CreatePartnerInput, ListPartnersQuery, UpdatePartnerInput } from './partner.schema.js';
+
+export const partnerController = {
+  list: async (req: Request, res: Response): Promise<void> => {
+    sendResponse({ res, message: 'Partners retrieved successfully', data: await partnerService.list(req.validatedQuery as ListPartnersQuery) });
+  },
+  get: async (req: Request, res: Response): Promise<void> => {
+    sendResponse({ res, message: 'Partner retrieved successfully', data: await partnerService.get(routeParam(req.params.id)) });
+  },
+  create: async (req: Request, res: Response): Promise<void> => {
+    sendResponse({ res, statusCode: 201, message: 'Partner created successfully', data: await partnerService.create(req.body as CreatePartnerInput, req.user!.userId) });
+  },
+  update: async (req: Request, res: Response): Promise<void> => {
+    sendResponse({ res, message: 'Partner updated successfully', data: await partnerService.update(routeParam(req.params.id), req.body as UpdatePartnerInput, req.user!.userId) });
+  },
+};
