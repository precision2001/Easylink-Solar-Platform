+-- AI platform: files and history by relationship, installer assignment history, partners.
+
+-- CreateEnum
+CREATE TYPE "PartnerKind" AS ENUM ('RETAILER', 'DNSP', 'SUPPLIER', 'FINANCE', 'OTHER');
+
+-- AlterTable: what the AI read each file as
+ALTER TABLE "installer_customer_documents"
+  ADD COLUMN "leadId" TEXT,
+  ADD COLUMN "s3Key" TEXT,
+  ADD COLUMN "aiLabels" JSONB,
+  ADD COLUMN "aiExtracted" JSONB,
+  ADD COLUMN "reviewState" TEXT,
+  ADD COLUMN "aiIssues" JSONB,
+  ADD COLUMN "aiUpdatedAt" TIMESTAMP(3);
+
+-- CreateIndex
+CREATE INDEX "installer_customer_documents_customerId_createdAt_idx" ON "installer_customer_documents"("customerId", "createdAt");
+
+-- AlterTable: the retailer as a partner
+ALTER TABLE "leads" ADD COLUMN "retailerPartnerId" TEXT;
+
+-- CreateTable
+CREATE TABLE "installer_assignments" (
+    "id" TEXT NOT NULL,
+    "leadId" TEXT NOT NULL,
+    "customerId" TEXT,
+    "installerId" TEXT NOT NULL,
+    "mode" TEXT NOT NULL DEFAULT 'REPLACE',
+    "reason" TEXT NOT NULL,
+    "assignedById" TEXT NOT NULL,
+    "startedAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    "endedAt" TIMESTAMP(3),
+    "endedById" TEXT,
+    "createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    "updatedAt" TIMESTAMP(3) NOT NULL,
+
+    CONSTRAINT "installer_assignments_pkey" PRIMARY KEY ("id")
+);
+
+-- CreateIndex
+CREATE INDEX "installer_assignments_leadId_endedAt_idx" ON "installer_assignments"("leadId", "endedAt");
+CREATE INDEX "installer_assignments_installerId_endedAt_idx" ON "installer_assignments"("installerId", "endedAt");
+CREATE INDEX "installer_assignments_customerId_endedAt_idx" ON "installer_assignments"("customerId", "endedAt");
+
+-- Backfill: every lead assigned today gets an open assignment row, so history starts complete.
+INSERT INTO "installer_assignments" ("id", "leadId", "customerId", "installerId", "mode", "reason", "assignedById", "startedAt", "updatedAt")
+SELECT gen_random_uuid()::text, l."id", d."userId", l."assignedToId", 'REPLACE', 'Assigned before history was kept', l."assignedToId", l."createdAt", CURRENT_TIMESTAMP
+FROM "leads" l
+LEFT JOIN "designs" d ON d."id" = l."designId"
+WHERE l."assignedToId" IS NOT NULL;
+
+-- CreateTable
+CREATE TABLE "partners" (
+    "id" TEXT NOT NULL,
+    "name" TEXT NOT NULL,
+    "kind" "PartnerKind" NOT NULL DEFAULT 'OTHER',
+    "aliases" TEXT[] DEFAULT ARRAY[]::TEXT[],
+    "domain" TEXT,
+    "email" TEXT,
+    "submissionEmail" TEXT,
+    "phone" TEXT,
+    "attach" BOOLEAN NOT NULL DEFAULT true,
+    "verified" BOOLEAN NOT NULL DEFAULT false,
+    "verifiedById" TEXT,
+    "verifiedAt" TIMESTAMP(3),
+    "source" JSONB,
+    "notes" TEXT,
+    "createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    "updatedAt" TIMESTAMP(3) NOT NULL,
+
+    CONSTRAINT "partners_pkey" PRIMARY KEY ("id")
+);
+
+-- CreateIndex
+CREATE INDEX "partners_kind_name_idx" ON "partners"("kind", "name");
