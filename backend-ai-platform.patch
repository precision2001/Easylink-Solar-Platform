+++ b/src/modules/projects/assignment.service.ts
@@ -0,0 +1,85 @@
+import { prisma } from '../../config/database.js';
+import { UserRole } from '../../generated/prisma/client.js';
+import { AppError } from '../../middlewares/errorHandler.js';
+import { logActivityEvent } from '../activity/activity.logger.js';
+import { emitLeadAssignedNotification } from '../notifications/notification-triggers.js';
+import { projectLeadIds } from './project.access.js';
+import type { AssignInstallerInput } from './project.schema.js';
+
+const name = (u: { firstName?: string | null; lastName?: string | null; email?: string | null } | null | undefined) =>
+  u ? [u.firstName, u.lastName].filter(Boolean).join(' ') || u.email || '' : '';
+
+/**
+ * Installer assignment with history. Staff assign (the AI platform runs this
+ * with its admin service account once a person has approved). REPLACE closes
+ * the current installer's row and moves `Lead.assignedToId`; ADD opens a row
+ * for a second installer alongside the main one.
+ */
+export class AssignmentService {
+  async list(customerId: string) {
+    const leadIds = await projectLeadIds(customerId);
+    await Promise.all(leadIds.map((id) => this.reconcile(id)));
+    return prisma.installerAssignment.findMany({ where: { leadId: { in: leadIds } }, orderBy: { startedAt: 'desc' } });
+  }
+
+  /**
+   * Keeps history in step when `PATCH /leads/:id/assign` (or any other path)
+   * moved `Lead.assignedToId` without going through here.
+   */
+  async reconcile(leadId: string) {
+    const lead = await prisma.lead.findUnique({ where: { id: leadId }, select: { id: true, assignedToId: true, design: { select: { userId: true } } } });
+    if (!lead) return;
+    const open = await prisma.installerAssignment.findMany({ where: { leadId, endedAt: null, mode: 'REPLACE' } });
+    if (!lead.assignedToId) return;
+    if (open.some((a) => a.installerId === lead.assignedToId)) return;
+    const now = new Date();
+    await prisma.$transaction([
+      prisma.installerAssignment.updateMany({ where: { leadId, endedAt: null, mode: 'REPLACE' }, data: { endedAt: now } }),
+      prisma.installerAssignment.create({
+        data: { leadId, customerId: lead.design?.userId ?? null, installerId: lead.assignedToId, mode: 'REPLACE', reason: 'Changed on the lead', assignedById: lead.assignedToId, startedAt: now },
+      }),
+    ]);
+  }
+
+  async assign(customerId: string, input: AssignInstallerInput, actorUserId: string) {
+    const leadIds = await projectLeadIds(customerId);
+    const leadId = input.leadId ?? leadIds[0];
+    if (!leadId || !leadIds.includes(leadId)) throw new AppError('This customer has no project (lead) to assign.', 400);
+    const installer = await prisma.user.findUnique({ where: { id: input.installerId }, select: { id: true, role: true, firstName: true, lastName: true, email: true } });
+    if (!installer) throw new AppError('Installer not found', 404);
+    if (installer.role !== UserRole.INSTALLER) throw new AppError('That user is not an installer', 400);
+    await this.reconcile(leadId);
+
+    const lead = await prisma.lead.findUnique({ where: { id: leadId }, select: { assignedToId: true, customerName: true } });
+    const now = new Date();
+    const previous = input.mode === 'REPLACE' ? await prisma.installerAssignment.findMany({ where: { leadId, endedAt: null, installerId: { not: installer.id } } }) : [];
+
+    const created = await prisma.$transaction(async (tx) => {
+      if (input.mode === 'REPLACE') {
+        await tx.installerAssignment.updateMany({ where: { leadId, endedAt: null, installerId: { not: installer.id } }, data: { endedAt: now, endedById: actorUserId } });
+        await tx.lead.update({ where: { id: leadId }, data: { assignedToId: installer.id } });
+      }
+      const already = await tx.installerAssignment.findFirst({ where: { leadId, installerId: installer.id, endedAt: null } });
+      if (already) return already;
+      return tx.installerAssignment.create({
+        data: { leadId, customerId, installerId: installer.id, mode: input.mode, reason: input.reason, assignedById: actorUserId, startedAt: now },
+      });
+    });
+
+    if (input.mode === 'REPLACE' && lead?.assignedToId !== installer.id) {
+      const before = lead?.assignedToId ? await prisma.user.findUnique({ where: { id: lead.assignedToId }, select: { firstName: true, lastName: true, email: true } }) : null;
+      await logActivityEvent({
+        entityType: 'LEAD',
+        entityId: leadId,
+        eventType: 'LEAD_ASSIGNMENT_CHANGED',
+        actorUserId,
+        summary: before ? `Installer changed from ${name(before)} to ${name(installer)}: ${input.reason}` : `${name(installer)} assigned: ${input.reason}`,
+        metadata: { previousAssignedToId: lead?.assignedToId ?? null, newAssignedToId: installer.id, reason: input.reason, mode: input.mode },
+      });
+      await emitLeadAssignedNotification({ assigneeUserId: installer.id, leadId, customerName: lead?.customerName ?? '', isReassign: Boolean(lead?.assignedToId) });
+    }
+    return { assignment: created, ended: previous.map((p) => p.installerId) };
+  }
+}
+
+export const assignmentService = new AssignmentService();
