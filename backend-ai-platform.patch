+import type { Request, Response } from 'express';
+import { sendResponse } from '../../utils/apiResponse.js';
+import { routeParam } from '../../utils/routeParams.js';
+import { assignmentService } from './assignment.service.js';
+import { projectService } from './project.service.js';
+import { resolveProjectAccess } from './project.access.js';
+import type { AssignInstallerInput, ListProjectsQuery } from './project.schema.js';
+
+const viewer = (req: Request) => ({ userId: req.user!.userId, role: req.user!.role });
+
+export const projectController = {
+  list: async (req: Request, res: Response): Promise<void> => {
+    const data = await projectService.list(viewer(req), req.validatedQuery as ListProjectsQuery);
+    sendResponse({ res, message: 'Projects retrieved successfully', data });
+  },
+
+  get: async (req: Request, res: Response): Promise<void> => {
+    const data = await projectService.get(viewer(req), routeParam(req.params.customerId));
+    sendResponse({ res, message: 'Project retrieved successfully', data });
+  },
+
+  items: async (req: Request, res: Response): Promise<void> => {
+    const data = await projectService.items(viewer(req), routeParam(req.params.customerId));
+    sendResponse({ res, message: 'Project items retrieved successfully', data });
+  },
+
+  userItems: async (req: Request, res: Response): Promise<void> => {
+    const data = await projectService.myItems(viewer(req), routeParam(req.params.userId));
+    sendResponse({ res, message: 'Items retrieved successfully', data });
+  },
+
+  assignments: async (req: Request, res: Response): Promise<void> => {
+    const customerId = routeParam(req.params.customerId);
+    await resolveProjectAccess(viewer(req), customerId);
+    const data = await assignmentService.list(customerId);
+    sendResponse({ res, message: 'Assignments retrieved successfully', data });
+  },
+
+  assign: async (req: Request, res: Response): Promise<void> => {
+    const data = await assignmentService.assign(routeParam(req.params.customerId), req.body as AssignInstallerInput, req.user!.userId);
+    sendResponse({ res, statusCode: 201, message: 'Installer assigned successfully', data });
+  },
+};
