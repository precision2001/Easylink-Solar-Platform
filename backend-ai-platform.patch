+import { z } from 'zod';
+
+export const listProjectsQuerySchema = z.object({
+  search: z.string().trim().max(120).optional(),
+  limit: z.coerce.number().int().positive().max(200).default(50),
+});
+
+export const projectCustomerParamSchema = z.object({
+  customerId: z.string().uuid('Invalid customer ID'),
+});
+
+export const userItemsParamSchema = z.object({
+  userId: z.string().uuid('Invalid user ID'),
+});
+
+export const assignInstallerSchema = z.object({
+  installerId: z.string().uuid('Invalid installer ID'),
+  /** Which of the customer's leads; defaults to their first. */
+  leadId: z.string().uuid('Invalid lead ID').optional(),
+  mode: z.enum(['REPLACE', 'ADD']).default('REPLACE'),
+  reason: z.string().trim().min(3, 'Give a reason').max(500),
+});
+
+export type ListProjectsQuery = z.infer<typeof listProjectsQuerySchema>;
+export type AssignInstallerInput = z.infer<typeof assignInstallerSchema>;
diff --git a/src/modules/projects/project.service.ts b/src/modules/projects/project.service.ts
new file mode 100644
index 0000000..4344bdf
--- /dev/null
+++ b/src/modules/projects/project.service.ts
@@ -0,0 +1,212 @@
+import { prisma } from '../../config/database.js';
+import { UserRole } from '../../generated/prisma/client.js';
+import { AppError } from '../../middlewares/errorHandler.js';
+import { installerCustomerIds, projectLeadIds, resolveProjectAccess, type Viewer } from './project.access.js';
+import { filterItems, iso, money, type ProjectItem } from './project.items.js';
+import type { ListProjectsQuery } from './project.schema.js';
+
+const name = (u: { firstName?: string | null; lastName?: string | null; email?: string | null } | null | undefined) =>
+  u ? [u.firstName, u.lastName].filter(Boolean).join(' ') || u.email || '' : '';
+
+const userBrief = { id: true, firstName: true, lastName: true, email: true, role: true } as const;
+
+export class ProjectService {
+  /** Projects this person may open: staff all (searchable), installers theirs, customers their own. */
+  async list(viewer: Viewer, query: ListProjectsQuery) {
+    let ids: string[] | null = null;
+    if (viewer.role === UserRole.INSTALLER) ids = await installerCustomerIds(viewer.userId);
+    if (viewer.role === UserRole.CUSTOMER) ids = [viewer.userId];
+    const where: Record<string, unknown> = { role: UserRole.CUSTOMER };
+    if (ids) where.id = { in: ids };
+    if (query.search) {
+      where.OR = [
+        { firstName: { contains: query.search, mode: 'insensitive' } },
+        { lastName: { contains: query.search, mode: 'insensitive' } },
+        { email: { contains: query.search, mode: 'insensitive' } },
+        { address: { contains: query.search, mode: 'insensitive' } },
+        { phone: { contains: query.search, mode: 'insensitive' } },
+      ];
+    }
+    const customers = await prisma.user.findMany({
+      where,
+      select: { id: true, firstName: true, lastName: true, email: true, address: true },
+      orderBy: { updatedAt: 'desc' },
+      take: query.limit,
+    });
+    const leads = await prisma.lead.findMany({
+      where: { design: { userId: { in: customers.map((c) => c.id) } } },
+      select: { id: true, status: true, projectPhase: true, design: { select: { userId: true } }, assignedTo: { select: userBrief } },
+    });
+    return customers.map((c) => {
+      const mine = leads.filter((l) => l.design?.userId === c.id);
+      return {
+        customerId: c.id,
+        name: name(c),
+        address: c.address ?? '',
+        status: mine[0]?.status ?? null,
+        phase: mine[0]?.projectPhase ?? null,
+        installers: mine.filter((l) => l.assignedTo).map((l) => ({ id: l.assignedTo!.id, name: name(l.assignedTo) })),
+      };
+    });
+  }
+
+  /** The project header: who it is, its leads, current and past installers, and what this viewer can do. */
+  async get(viewer: Viewer, customerId: string) {
+    const access = await resolveProjectAccess(viewer, customerId);
+    const customer = await prisma.user.findUnique({
+      where: { id: customerId },
+      select: { id: true, firstName: true, lastName: true, email: true, phone: true, address: true, role: true },
+    });
+    if (!customer || customer.role !== UserRole.CUSTOMER) throw new AppError('Customer not found', 404);
+    const leadIds = await projectLeadIds(customerId);
+    const [leads, assignments] = await Promise.all([
+      prisma.lead.findMany({
+        where: { id: { in: leadIds } },
+        select: { id: true, status: true, projectPhase: true, currentMilestoneKey: true, retailer: true, retailerPartnerId: true, assignedTo: { select: userBrief } },
+      }),
+      prisma.installerAssignment.findMany({ where: { leadId: { in: leadIds } }, orderBy: { startedAt: 'desc' } }),
+    ]);
+    const installerIds = [...new Set(assignments.map((a) => a.installerId))];
+    const installers = await prisma.user.findMany({ where: { id: { in: installerIds } }, select: userBrief });
+    const byId = new Map(installers.map((u) => [u.id, u]));
+    return {
+      customerId,
+      name: name(customer),
+      address: customer.address ?? '',
+      // Contact details for staff and the installer on the job.
+      contact: access === 'customer' ? null : { email: customer.email, phone: customer.phone },
+      leads: leads.map((l) => ({ id: l.id, status: l.status, phase: l.projectPhase, milestone: l.currentMilestoneKey, retailer: l.retailer, retailerPartnerId: l.retailerPartnerId })),
+      installers: leads.filter((l) => l.assignedTo).map((l) => ({ id: l.assignedTo!.id, name: name(l.assignedTo), leadId: l.id })),
+      installerHistory: assignments.map((a) => ({
+        installer: { id: a.installerId, name: name(byId.get(a.installerId)) },
+        leadId: a.leadId,
+        mode: a.mode,
+        reason: a.reason,
+        startedAt: iso(a.startedAt),
+        endedAt: iso(a.endedAt),
+        ...(access === 'staff' ? { assignedById: a.assignedById, endedById: a.endedById } : {}),
+      })),
+      access,
+      can: { assignInstaller: access === 'staff', requestInstallerChange: access !== 'staff' },
+    };
+  }
+
+  /** Everything for or about the project that this viewer may see, newest first. */
+  async items(viewer: Viewer, customerId: string): Promise<ProjectItem[]> {
+    const access = await resolveProjectAccess(viewer, customerId);
+    const leadIds = await projectLeadIds(customerId);
+    const [docs, designs, leads, appts, milestones, payments, invoices, calls, convs, notes, tasks, profiles, activity, assignments] = await Promise.all([
+      prisma.installerCustomerDocument.findMany({ where: { customerId }, orderBy: { createdAt: 'desc' } }),
+      prisma.design.findMany({ where: { userId: customerId }, include: { products: { include: { product: { select: { name: true, category: true } } } } } }),
+      prisma.lead.findMany({ where: { id: { in: leadIds } } }),
+      prisma.appointment.findMany({ where: { OR: [{ customerId }, { leadId: { in: leadIds } }] }, include: { installer: { select: userBrief } } }),
+      prisma.projectMilestone.findMany({ where: { leadId: { in: leadIds } } }),
+      prisma.payment.findMany({ where: { customerId }, include: { payout: true } }),
+      prisma.invoice.findMany({ where: { OR: [{ toUserId: customerId }, { fromUserId: customerId }] } }),
+      prisma.call.findMany({ where: { leadId: { in: leadIds } } }),
+      prisma.conversation.findMany({ where: { customerId }, include: { messages: { orderBy: { createdAt: 'desc' }, take: 200 }, installer: { select: userBrief } } }),
+      prisma.installerNote.findMany({ where: { customerId } }),
+      prisma.installerTask.findMany({ where: { customerId } }),
+      prisma.installerCustomerProfile.findMany({ where: { customerId } }),
+      prisma.activityEvent.findMany({
+        where: { OR: [{ entityType: 'CUSTOMER', entityId: customerId }, { entityType: 'LEAD', entityId: { in: leadIds } }] },
+        orderBy: { createdAt: 'desc' },
+        take: 300,
+      }),
+      prisma.installerAssignment.findMany({ where: { leadId: { in: leadIds } } }),
+    ]);
+
+    const items: ProjectItem[] = [];
+    const push = (i: Omit<ProjectItem, 'key'>) => items.push({ ...i, key: `${i.kind}:${i.id}` });
+
+    for (const d of docs)
+      push({
+        kind: 'document', id: d.id, title: d.fileName, subtitle: d.mimeType, at: iso(d.createdAt),
+        status: d.reviewState ?? null, amount: null, byUserId: d.installerId, url: d.url,
+        data: { mimeType: d.mimeType, sizeBytes: d.sizeBytes, leadId: d.leadId, aiLabels: d.aiLabels, aiExtracted: d.aiExtracted, aiIssues: d.aiIssues, s3Key: d.s3Key },
+      });
+    for (const d of designs)
+      push({
+        kind: 'design', id: d.id, title: d.title, subtitle: [d.panelCount ? `${d.panelCount} panels` : null, d.products.map((p) => p.product.name).slice(0, 3).join(', ') || null].filter(Boolean).join(' · '),
+        at: iso(d.updatedAt), status: d.status, amount: money(d.products.reduce((s, p) => s + (p.totalPrice ?? 0), 0) || null), byUserId: null, url: null,
+        data: { address: d.address, panelCount: d.panelCount, roofArea: d.roofArea, estimatedSavings: d.estimatedSavings, selected: !!d.selectedByCustomerAt, customerNotes: d.customerNotes },
+      });
+    for (const l of leads)
+      push({
+        kind: 'lead', id: l.id, title: `Project · ${l.status.toLowerCase().replace(/_/g, ' ')}`, subtitle: l.projectPhase.toLowerCase().replace(/_/g, ' '), at: iso(l.updatedAt),
+        status: l.status, amount: null, byUserId: l.assignedToId, url: null,
+        data: { address: l.address, phase: l.projectPhase, milestone: l.currentMilestoneKey, retailer: l.retailer, customerEmail: l.customerEmail, customerPhone: l.customerPhone, notes: l.notes, estimatedValue: l.estimatedValue },
+      });
+    for (const a of appts)
+      push({
+        kind: 'appointment', id: a.id, title: a.title, subtitle: `${a.startAt.toISOString()} · ${name(a.installer)}`, at: iso(a.startAt),
+        status: a.status, amount: null, byUserId: a.installerId, url: null, data: { startAt: iso(a.startAt), endAt: iso(a.endAt), notes: a.notes, leadId: a.leadId },
+      });
+    for (const m of milestones)
+      push({ kind: 'milestone', id: m.id, title: `Reached: ${m.key.replace(/[_-]/g, ' ')}`, subtitle: m.note ?? '', at: iso(m.completedAt), status: null, amount: null, byUserId: m.completedById, url: null, data: { leadId: m.leadId, key: m.key } });
+    for (const p of payments)
+      push({
+        kind: 'payment', id: p.id, title: p.description, subtitle: [p.kind.toLowerCase().replace(/_/g, ' '), p.payoutStatus === 'PAID_OUT' ? 'paid out to installer' : null].filter(Boolean).join(' · '),
+        at: iso(p.paidAt ?? p.createdAt), status: p.status, amount: money(p.amountMinor, p.currency, true), byUserId: p.installerId, url: p.receiptUrl,
+        data: { kind: p.kind, provider: p.provider, refunded: money(p.amountRefundedMinor, p.currency, true), customerEmail: p.customerEmail, stripeSessionId: p.stripeSessionId, stripePaymentIntentId: p.stripePaymentIntentId, afterpayToken: p.afterpayToken, afterpayPaymentId: p.afterpayPaymentId },
+      });
+    for (const v of invoices)
+      push({ kind: 'invoice', id: v.id, title: `Invoice ${v.invoiceNumber}`, subtitle: `${v.fromName} → ${v.toName} · due ${v.dueDate.toISOString().slice(0, 10)}`, at: iso(v.issueDate), status: v.status, amount: money(v.total), byUserId: v.fromUserId, url: null, data: { kind: v.kind } });
+    for (const c of calls)
+      push({
+        kind: 'call', id: c.id, title: `${c.direction === 'INBOUND' ? 'Call from' : 'Call to'} the customer`, subtitle: [c.outcome?.toLowerCase().replace(/_/g, ' '), c.durationSec ? `${Math.round(c.durationSec / 60)} min` : null].filter(Boolean).join(' · '),
+        at: iso(c.startedAt), status: c.status, amount: null, byUserId: c.agentUserId, url: null, data: { outcome: c.outcome, durationSec: c.durationSec, notes: c.notes, counterpartyNumber: c.counterpartyNumber, fromNumber: c.fromNumber },
+      });
+    for (const cv of convs)
+      for (const m of cv.messages)
+        push({ kind: 'message', id: m.id, title: m.body.slice(0, 140), subtitle: `Portal chat with ${name(cv.installer)}`, at: iso(m.createdAt), status: null, amount: null, byUserId: m.senderId, url: null, data: { conversationId: cv.id, fromCustomer: m.senderId === customerId } });
+    for (const n of notes)
+      push({ kind: 'note', id: n.id, title: n.title, subtitle: n.content.slice(0, 160), at: iso(n.updatedAt), status: null, amount: null, byUserId: n.installerId, url: null, data: {} });
+    for (const t of tasks)
+      push({ kind: 'task', id: t.id, title: t.title, subtitle: t.content.slice(0, 160), at: iso(t.updatedAt), status: null, amount: null, byUserId: t.installerId, url: null, data: {} });
+    for (const p of profiles)
+      push({ kind: 'profile', id: p.id, title: 'Customer profile', subtitle: p.customerType, at: iso(p.updatedAt), status: null, amount: money(p.salePrice), byUserId: p.installerId, url: null, data: { salePrice: p.salePrice, profit: p.profit } });
+    for (const e of activity)
+      push({ kind: 'activity', id: e.id, title: e.summary, subtitle: e.eventType.toLowerCase().replace(/_/g, ' '), at: iso(e.createdAt), status: null, amount: null, byUserId: e.actorUserId, url: null, data: { eventType: e.eventType } });
+    for (const a of assignments)
+      push({ kind: 'assignment', id: a.id, title: a.endedAt ? 'Installer changed' : 'Installer assigned', subtitle: a.reason, at: iso(a.endedAt ?? a.startedAt), status: a.endedAt ? 'ended' : 'current', amount: null, byUserId: a.installerId, url: null, data: { leadId: a.leadId, mode: a.mode, assignedById: a.assignedById, endedById: a.endedById } });
+
+    return filterItems(items, access, viewer.userId);
+  }
+
+  /**
+   * Everything for or about a person themselves (installer or customer) —
+   * the same rule for every entity. Staff may open anyone's.
+   */
+  async myItems(viewer: Viewer, userId: string): Promise<ProjectItem[]> {
+    if (viewer.role !== UserRole.ADMIN && viewer.userId !== userId) throw new AppError('You can only see your own items.', 403);
+    const user = await prisma.user.findUnique({ where: { id: userId }, select: { id: true, role: true } });
+    if (!user) throw new AppError('User not found', 404);
+    const items: ProjectItem[] = [];
+    const push = (i: Omit<ProjectItem, 'key'>) => items.push({ ...i, key: `${i.kind}:${i.id}` });
+    const [payments, invoices, docs, appts, tasks] = await Promise.all([
+      prisma.payment.findMany({ where: user.role === UserRole.INSTALLER ? { installerId: userId } : { customerId: userId }, include: { payout: true } }),
+      prisma.invoice.findMany({ where: { OR: [{ toUserId: userId }, { fromUserId: userId }] } }),
+      prisma.installerCustomerDocument.findMany({ where: user.role === UserRole.INSTALLER ? { installerId: userId } : { customerId: userId }, orderBy: { createdAt: 'desc' }, take: 500 }),
+      prisma.appointment.findMany({ where: user.role === UserRole.INSTALLER ? { installerId: userId } : { customerId: userId }, take: 500 }),
+      user.role === UserRole.INSTALLER ? prisma.installerTask.findMany({ where: { installerId: userId } }) : Promise.resolve([]),
+    ]);
+    for (const p of payments)
+      push({
+        kind: 'payment', id: p.id, title: p.description, subtitle: [p.customerName, p.payout ? `paid out ${p.payout.paidAt.toISOString().slice(0, 10)}` : p.kind === 'SERVICE' ? 'not paid out yet' : null].filter(Boolean).join(' · '),
+        at: iso(p.paidAt ?? p.createdAt), status: p.status, amount: money(p.amountMinor, p.currency, true), byUserId: p.installerId, url: p.receiptUrl, data: { kind: p.kind, payoutStatus: p.payoutStatus },
+      });
+    for (const v of invoices)
+      push({ kind: 'invoice', id: v.id, title: `Invoice ${v.invoiceNumber}`, subtitle: `${v.fromName} → ${v.toName}`, at: iso(v.issueDate), status: v.status, amount: money(v.total), byUserId: v.fromUserId, url: null, data: { kind: v.kind } });
+    for (const d of docs)
+      push({ kind: 'document', id: d.id, title: d.fileName, subtitle: d.mimeType, at: iso(d.createdAt), status: d.reviewState ?? null, amount: null, byUserId: d.installerId, url: d.url, data: { customerId: d.customerId, aiLabels: d.aiLabels } });
+    for (const a of appts)
+      push({ kind: 'appointment', id: a.id, title: a.title, subtitle: a.startAt.toISOString(), at: iso(a.startAt), status: a.status, amount: null, byUserId: a.installerId, url: null, data: { customerId: a.customerId, leadId: a.leadId } });
+    for (const t of tasks)
+      push({ kind: 'task', id: t.id, title: t.title, subtitle: t.content.slice(0, 160), at: iso(t.updatedAt), status: null, amount: null, byUserId: t.installerId, url: null, data: { customerId: t.customerId } });
+    // A person's own items are all theirs; staff see them as staff.
+    return filterItems(items, viewer.role === UserRole.ADMIN ? 'staff' : user.role === UserRole.INSTALLER ? 'installer' : 'customer', viewer.userId);
+  }
+}
+
+export const projectService = new ProjectService();
