@@ -0,0 +1,96 @@
+import type { ProjectAccess } from './project.access.js';
+
+/**
+ * One list of everything for or about a project, with who may see each kind.
+ * The service loads rows; this file decides visibility and the shape, so the
+ * rules live in one place and are unit-tested without a database.
+ */
+export type ItemKind =
+  | 'document'
+  | 'design'
+  | 'lead'
+  | 'appointment'
+  | 'milestone'
+  | 'payment'
+  | 'invoice'
+  | 'call'
+  | 'message'
+  | 'note'
+  | 'task'
+  | 'profile'
+  | 'activity'
+  | 'assignment';
+
+export type ProjectItem = {
+  key: string;
+  kind: ItemKind;
+  id: string;
+  title: string;
+  subtitle: string;
+  at: string | null;
+  status: string | null;
+  amount: string | null;
+  /** The installer (or other user) the item came from, if any. */
+  byUserId: string | null;
+  /** Openable file or link, when the item has one. */
+  url: string | null;
+  data: Record<string, unknown>;
+};
+
+/**
+ * Who sees each kind on a project.
+ *   - Installer notes, tasks and the activity log are working records: staff
+ *     and the installer on the job, never the customer.
+ *   - An installer's sale price and profit for a customer are that installer's
+ *     own business: staff and that installer only (checked per row below).
+ *   - Call records show to the customer without the agent's wrap-up notes.
+ */
+export const VISIBLE: Record<ItemKind, ProjectAccess[]> = {
+  document: ['staff', 'installer', 'customer'],
+  design: ['staff', 'installer', 'customer'],
+  lead: ['staff', 'installer', 'customer'],
+  appointment: ['staff', 'installer', 'customer'],
+  milestone: ['staff', 'installer', 'customer'],
+  payment: ['staff', 'installer', 'customer'],
+  invoice: ['staff', 'installer', 'customer'],
+  call: ['staff', 'installer', 'customer'],
+  message: ['staff', 'installer', 'customer'],
+  assignment: ['staff', 'installer', 'customer'],
+  note: ['staff', 'installer'],
+  task: ['staff', 'installer'],
+  activity: ['staff', 'installer'],
+  profile: ['staff', 'installer'],
+};
+
+/** Fields that never leave the backend for a non-staff viewer. */
+const STAFF_ONLY_FIELDS: Partial<Record<ItemKind, string[]>> = {
+  call: ['notes', 'counterpartyNumber', 'fromNumber'],
+  payment: ['customerEmail', 'stripeSessionId', 'stripePaymentIntentId', 'afterpayToken', 'afterpayPaymentId'],
+  lead: ['customerEmail', 'customerPhone', 'notes', 'estimatedValue'],
+  assignment: ['assignedById', 'endedById'],
+};
+
+export function filterItems(items: ProjectItem[], access: ProjectAccess, viewerId: string): ProjectItem[] {
+  return items
+    .filter((i) => VISIBLE[i.kind].includes(access))
+    .filter((i) => i.kind !== 'profile' || access === 'staff' || i.byUserId === viewerId)
+    .map((i) => {
+      if (access === 'staff') return i;
+      const hide = STAFF_ONLY_FIELDS[i.kind] ?? [];
+      const data = Object.fromEntries(Object.entries(i.data).filter(([k]) => !hide.includes(k)));
+      // The assigned installer needs the customer's own contact details to do the job.
+      if (i.kind === 'lead' && access === 'installer') {
+        data.customerEmail = i.data.customerEmail;
+        data.customerPhone = i.data.customerPhone;
+      }
+      return { ...i, data };
+    })
+    .sort((a, b) => String(b.at ?? '').localeCompare(String(a.at ?? '')));
+}
+
+export const money = (minorOrMajor: number | null | undefined, currency = 'AUD', minor = false) =>
+  minorOrMajor == null
+    ? null
+    : new Intl.NumberFormat('en-AU', { style: 'currency', currency: (currency || 'AUD').toUpperCase() }).format(minor ? minorOrMajor / 100 : minorOrMajor);
+
+export const iso = (d: Date | null | undefined) => (d ? d.toISOString() : null);
