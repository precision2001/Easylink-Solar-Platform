+import { Router } from 'express';
+import { UserRole } from '../../generated/prisma/client.js';
+import { authenticate } from '../../middlewares/auth.js';
+import { authorize } from '../../middlewares/roleGuard.js';
+import { validate } from '../../middlewares/validate.js';
+import { asyncHandler } from '../../utils/asyncHandler.js';
+import { projectController } from './project.controller.js';
+import {
+  assignInstallerSchema,
+  listProjectsQuerySchema,
+  projectCustomerParamSchema,
+  userItemsParamSchema,
+} from './project.schema.js';
+
+/**
+ * Projects: everything for or about a customer, shown by relationship.
+ * Staff see every project; installers the customers assigned to them now;
+ * customers their own. See docs/RBAC_ENDPOINT_MATRIX.md → Projects.
+ */
+const router = Router();
+const anyone = [UserRole.ADMIN, UserRole.INSTALLER, UserRole.CUSTOMER];
+
+router.get('/', authenticate, authorize(...anyone), validate({ query: listProjectsQuerySchema }), asyncHandler(projectController.list));
+
+/** Everything for or about a person themselves (payments, payouts, invoices, files, bookings, tasks). */
+router.get('/people/:userId/items', authenticate, authorize(...anyone), validate({ params: userItemsParamSchema }), asyncHandler(projectController.userItems));
+
+router.get('/:customerId', authenticate, authorize(...anyone), validate({ params: projectCustomerParamSchema }), asyncHandler(projectController.get));
+router.get('/:customerId/items', authenticate, authorize(...anyone), validate({ params: projectCustomerParamSchema }), asyncHandler(projectController.items));
+router.get('/:customerId/assignments', authenticate, authorize(...anyone), validate({ params: projectCustomerParamSchema }), asyncHandler(projectController.assignments));
+router.post(
+  '/:customerId/assignments',
+  authenticate,
+  authorize(UserRole.ADMIN),
+  validate({ params: projectCustomerParamSchema, body: assignInstallerSchema }),
+  asyncHandler(projectController.assign),
+);
+
+export default router;
