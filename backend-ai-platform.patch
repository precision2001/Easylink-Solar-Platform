+import { describe, expect, it } from 'vitest';
+import { filterItems, type ProjectItem, type ItemKind } from '../src/modules/projects/project.items.js';
+
+const item = (kind: ItemKind, extra: Partial<ProjectItem> = {}): ProjectItem => ({
+  key: `${kind}:1`, kind, id: '1', title: kind, subtitle: '', at: '2026-10-01T00:00:00.000Z',
+  status: null, amount: null, byUserId: null, url: null, data: {}, ...extra,
+});
+const all: ProjectItem[] = [
+  item('document'), item('design'), item('invoice'), item('payment', { data: { stripeSessionId: 'cs_1', customerEmail: 'a@b.au', status: 'PAID' } }),
+  item('note'), item('task'), item('activity'),
+  item('profile', { key: 'profile:mine', byUserId: 'inst-1' }), item('profile', { key: 'profile:other', byUserId: 'inst-2' }),
+  item('call', { data: { notes: 'wrap-up', fromNumber: '+61400000000', durationSec: 60 } }),
+  item('lead', { data: { customerEmail: 'c@x.au', customerPhone: '0400', notes: 'internal', status: 'NEW' } }),
+];
+const kinds = (xs: ProjectItem[]) => xs.map((x) => x.kind);
+
+describe('project item visibility', () => {
+  it('customers never see installer notes, tasks, the activity log or installer profiles', () => {
+    const k = kinds(filterItems(all, 'customer', 'cust-1'));
+    expect(k).not.toContain('note');
+    expect(k).not.toContain('task');
+    expect(k).not.toContain('activity');
+    expect(k).not.toContain('profile');
+    expect(k).toEqual(expect.arrayContaining(['document', 'design', 'invoice', 'payment', 'call', 'lead']));
+  });
+
+  it('the assigned installer sees notes and tasks, and only their own profile row', () => {
+    const out = filterItems(all, 'installer', 'inst-1');
+    expect(kinds(out)).toEqual(expect.arrayContaining(['note', 'task', 'activity']));
+    expect(out.filter((i) => i.kind === 'profile').map((i) => i.key)).toEqual(['profile:mine']);
+  });
+
+  it('strips staff-only fields for non-staff, keeps lead contacts for the installer', () => {
+    const cust = filterItems(all, 'customer', 'cust-1');
+    expect(cust.find((i) => i.kind === 'call')!.data).toEqual({ durationSec: 60 });
+    expect(cust.find((i) => i.kind === 'payment')!.data).toEqual({ status: 'PAID' });
+    expect(cust.find((i) => i.kind === 'lead')!.data).toEqual({ status: 'NEW' });
+    const inst = filterItems(all, 'installer', 'inst-1').find((i) => i.kind === 'lead')!;
+    expect(inst.data).toEqual({ status: 'NEW', customerEmail: 'c@x.au', customerPhone: '0400' });
+  });
+
+  it('staff see everything unchanged', () => {
+    expect(filterItems(all, 'staff', 'admin').length).toBe(all.length);
+  });
+});
