+
+/**
+ * Who has been the installer on a project, and when. One open row (endedAt
+ * null) per installer currently on the lead; replacing an installer closes
+ * their row. `Lead.assignedToId` stays the current main installer so existing
+ * screens keep working; this table is the history and the access rule:
+ * an installer sees a customer's project while they have an open row.
+ */
+model InstallerAssignment {
+  id           String    @id @default(uuid())
+  leadId       String
+  /**
+   * The customer (design owner) at the time of assignment, for fast lookups.
+   */
+  customerId   String?
+  installerId  String
+  /**
+   * REPLACE (took over) or ADD (works alongside the main installer).
+   */
+  mode         String    @default("REPLACE")
+  reason       String
+  assignedById String
+  startedAt    DateTime  @default(now())
+  endedAt      DateTime?
+  endedById    String?
+  createdAt    DateTime  @default(now())
+  updatedAt    DateTime  @updatedAt
+
+  @@index([leadId, endedAt])
+  @@index([installerId, endedAt])
+  @@index([customerId, endedAt])
+  @@map("installer_assignments")
+}
+
+/**
+ * Organisations documents are sent to: electricity retailers, DNSPs,
+ * suppliers, finance providers. Contacts the AI finds on an organisation's
+ * own website are saved unverified; the first send to one needs a staff OK.
+ */
+model Partner {
+  id              String      @id @default(uuid())
+  name            String
+  kind            PartnerKind @default(OTHER)
+  /**
+   * Other names it goes by (e.g. "Origin" for "Origin Energy").
+   */
+  aliases         String[]    @default([])
+  domain          String?
+  email           String?
+  /**
+   * Where installation documents go, when different from the general email.
+   */
+  submissionEmail String?
+  phone           String?
+  /**
+   * Send files as attachments rather than links.
+   */
+  attach          Boolean     @default(true)
+  verified        Boolean     @default(false)
+  verifiedById    String?
+  verifiedAt      DateTime?
+  /**
+   * Where the AI found the contact: { url, query, why, foundAt }.
+   */
+  source          Json?
+  notes           String?
+  createdAt       DateTime    @default(now())
+  updatedAt       DateTime    @updatedAt
+
+  @@index([kind, name])
+  @@map("partners")
+}
