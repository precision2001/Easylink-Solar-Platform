@@ -0,0 +1,17 @@
+import { Router } from 'express';
+import { UserRole } from '../../generated/prisma/client.js';
+import { authenticate } from '../../middlewares/auth.js';
+import { authorize } from '../../middlewares/roleGuard.js';
+import { validate } from '../../middlewares/validate.js';
+import { asyncHandler } from '../../utils/asyncHandler.js';
+import { partnerController } from './partner.controller.js';
+import { createPartnerSchema, listPartnersQuerySchema, partnerIdParamSchema, updatePartnerSchema } from './partner.schema.js';
+
+const router = Router();
+
+router.get('/', authenticate, authorize(UserRole.ADMIN, UserRole.INSTALLER, UserRole.CUSTOMER), validate({ query: listPartnersQuerySchema }), asyncHandler(partnerController.list));
+router.get('/:id', authenticate, authorize(UserRole.ADMIN, UserRole.INSTALLER, UserRole.CUSTOMER), validate({ params: partnerIdParamSchema }), asyncHandler(partnerController.get));
+router.post('/', authenticate, authorize(UserRole.ADMIN), validate({ body: createPartnerSchema }), asyncHandler(partnerController.create));
+router.patch('/:id', authenticate, authorize(UserRole.ADMIN), validate({ params: partnerIdParamSchema, body: updatePartnerSchema }), asyncHandler(partnerController.update));
+
+export default router;
diff --git a/src/modules/partners/partner.schema.ts b/src/modules/partners/partner.schema.ts
new file mode 100644
index 0000000..ac23158
--- /dev/null
+++ b/src/modules/partners/partner.schema.ts
@@ -0,0 +1,31 @@
+import { z } from 'zod';
+
+const kind = z.enum(['RETAILER', 'DNSP', 'SUPPLIER', 'FINANCE', 'OTHER']);
+
+export const listPartnersQuerySchema = z.object({
+  kind: kind.optional(),
+  search: z.string().trim().max(120).optional(),
+});
+
+export const partnerIdParamSchema = z.object({ id: z.string().uuid('Invalid partner ID') });
+
+export const createPartnerSchema = z.object({
+  name: z.string().trim().min(2).max(200),
+  kind: kind.default('OTHER'),
+  aliases: z.array(z.string().trim().min(1).max(100)).max(20).default([]),
+  domain: z.string().trim().max(255).optional(),
+  email: z.string().trim().email().optional(),
+  submissionEmail: z.string().trim().email().optional(),
+  phone: z.string().trim().max(40).optional(),
+  attach: z.boolean().default(true),
+  verified: z.boolean().default(false),
+  /** Where the AI found it: { url, query, why, foundAt }. */
+  source: z.record(z.string(), z.unknown()).optional(),
+  notes: z.string().trim().max(2000).optional(),
+});
+
+export const updatePartnerSchema = createPartnerSchema.partial();
+
+export type ListPartnersQuery = z.infer<typeof listPartnersQuerySchema>;
+export type CreatePartnerInput = z.infer<typeof createPartnerSchema>;
+export type UpdatePartnerInput = z.infer<typeof updatePartnerSchema>;
