+import { prisma } from '../../config/database.js';
+import type { Prisma } from '../../generated/prisma/client.js';
+import { AppError } from '../../middlewares/errorHandler.js';
+import type { CreatePartnerInput, ListPartnersQuery, UpdatePartnerInput } from './partner.schema.js';
+
+/** Retailers, DNSPs, suppliers: who documents are sent to. Staff manage; everyone signed in may look one up. */
+export class PartnerService {
+  list(query: ListPartnersQuery) {
+    const where: Prisma.PartnerWhereInput = {};
+    if (query.kind) where.kind = query.kind;
+    if (query.search) {
+      where.OR = [{ name: { contains: query.search, mode: 'insensitive' } }, { aliases: { has: query.search } }, { domain: { contains: query.search, mode: 'insensitive' } }];
+    }
+    return prisma.partner.findMany({ where, orderBy: { name: 'asc' }, take: 500 });
+  }
+
+  async get(id: string) {
+    const p = await prisma.partner.findUnique({ where: { id } });
+    if (!p) throw new AppError('Partner not found', 404);
+    return p;
+  }
+
+  create(input: CreatePartnerInput, actorUserId: string) {
+    return prisma.partner.create({
+      data: {
+        ...input,
+        source: input.source as Prisma.InputJsonValue | undefined,
+        ...(input.verified ? { verifiedById: actorUserId, verifiedAt: new Date() } : {}),
+      },
+    });
+  }
+
+  async update(id: string, input: UpdatePartnerInput, actorUserId: string) {
+    const cur = await this.get(id);
+    return prisma.partner.update({
+      where: { id },
+      data: {
+        ...input,
+        source: input.source as Prisma.InputJsonValue | undefined,
+        ...(input.verified && !cur.verified ? { verifiedById: actorUserId, verifiedAt: new Date() } : {}),
+      },
+    });
+  }
+}
+
+export const partnerService = new PartnerService();
