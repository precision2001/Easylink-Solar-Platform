@@ -0,0 +1,72 @@
+import { describe, expect, it, vi, beforeEach } from 'vitest';
+import express from 'express';
+import request from 'supertest';
+
+const db = vi.hoisted(() => ({
+  installerAssignment: { findMany: vi.fn(async () => [] as unknown[]) },
+  lead: { findMany: vi.fn(async () => [] as unknown[]) },
+}));
+vi.mock('../src/config/database.js', () => ({ prisma: db }));
+
+const { default: projectRoutes } = await import('../src/modules/projects/project.routes.js');
+const { default: partnerRoutes } = await import('../src/modules/partners/partner.routes.js');
+const { default: docRoutes } = await import('../src/modules/installer-customer-documents/installer-customer-document.routes.js');
+const { generateAccessToken } = await import('../src/utils/token.js');
+
+const app = express();
+app.use(express.json());
+app.use('/projects', projectRoutes);
+app.use('/partners', partnerRoutes);
+app.use('/installer-customer-documents', docRoutes);
+app.use((err: { statusCode?: number; message: string }, _req: express.Request, res: express.Response, _next: express.NextFunction) => {
+  res.status(err.statusCode ?? 500).json({ success: false, message: err.message });
+});
+
+const CUST = '11111111-1111-4111-8111-111111111111';
+const OTHER = '22222222-2222-4222-8222-222222222222';
+const INST = '33333333-3333-4333-8333-333333333333';
+const tok = (role: string, userId: string) => `Bearer ${generateAccessToken({ userId, email: 'x@y.au', role })}`;
+
+beforeEach(() => {
+  db.installerAssignment.findMany.mockResolvedValue([]);
+  db.lead.findMany.mockResolvedValue([]);
+});
+
+describe('projects access', () => {
+  it('needs a token', async () => {
+    expect((await request(app).get(`/projects/${CUST}/items`)).status).toBe(401);
+  });
+
+  it('a customer cannot open another customer\'s project', async () => {
+    const r = await request(app).get(`/projects/${OTHER}/assignments`).set('Authorization', tok('CUSTOMER', CUST));
+    expect(r.status).toBe(403);
+  });
+
+  it('an installer cannot open a customer not assigned to them', async () => {
+    const r = await request(app).get(`/projects/${CUST}/assignments`).set('Authorization', tok('INSTALLER', INST));
+    expect(r.status).toBe(403);
+  });
+
+  it('only staff can change the installer', async () => {
+    const body = { installerId: INST, mode: 'REPLACE', reason: 'Customer asked' };
+    for (const role of ['CUSTOMER', 'INSTALLER']) {
+      const r = await request(app).post(`/projects/${CUST}/assignments`).set('Authorization', tok(role, CUST)).send(body);
+      expect(r.status).toBe(403);
+    }
+  });
+});
+
+describe('partners and document AI fields', () => {
+  it('only staff can add partners', async () => {
+    const r = await request(app).post('/partners').set('Authorization', tok('INSTALLER', INST)).send({ name: 'Sunrise Power', kind: 'RETAILER' });
+    expect(r.status).toBe(403);
+  });
+
+  it('only staff can write AI labels on a document', async () => {
+    const r = await request(app)
+      .patch(`/installer-customer-documents/${CUST}/ai`)
+      .set('Authorization', tok('INSTALLER', INST))
+      .send({ reviewState: 'confirmed' });
+    expect(r.status).toBe(403);
+  });
+});
